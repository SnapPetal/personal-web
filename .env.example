# =============================================================================
# Personal Web Application - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env file to version control!

# =============================================================================
# AWS Credentials
# =============================================================================
# AWS Access Key ID for S3, S3 Vectors, SES, Polly, and MediaConvert
PERSONAL_AWS_ACCESS_KEY_ID=

# AWS Secret Access Key
PERSONAL_AWS_SECRET_ACCESS_KEY=

# AWS Region (default: us-east-1)
PERSONAL_AWS_REGION=us-east-1

# =============================================================================
# OpenAI / Spring AI
# =============================================================================
# API key used by Spring AI for chat, vision, embeddings, and image generation
PERSONAL_OPENAI_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
PERSONAL_OPENAI_CHAT_MODEL=gpt-4o
PERSONAL_OPENAI_TRIVIA_MODEL=gpt-4o-mini
PERSONAL_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PERSONAL_OPENAI_EMBEDDING_DIMENSIONS=1024
PERSONAL_OPENAI_IMAGE_MODEL=dall-e-3
PERSONAL_OPENAI_IMAGE_RESPONSES_MODEL=gpt-4.1-mini

# =============================================================================
# PostHog Feature Flags / Analytics
# =============================================================================
# Set to true to enable PostHog bootstrap and backend capture
PERSONAL_POSTHOG_ENABLED=false

# Public PostHog project API key
PERSONAL_POSTHOG_API_KEY=

# Public PostHog project token used by the browser SDK and feature flags
PERSONAL_POSTHOG_PROJECT_TOKEN=

# PostHog API host used by backend capture. Change this only if your project uses a different region
PERSONAL_POSTHOG_API_HOST=https://us.i.posthog.com

# First-party browser proxy host. The production nginx reference uses e.thonbecker.biz.
PERSONAL_POSTHOG_BROWSER_API_HOST=https://e.thonbecker.biz

# =============================================================================
# Skatetricks Upload / Transcoding
# =============================================================================
# Max browser-upload size accepted by the app and presign endpoint
SKATETRICKS_UPLOAD_MAX_FILE_SIZE=500MB
SKATETRICKS_UPLOAD_MAX_REQUEST_SIZE=500MB

# Lifetime of the presigned S3 upload URL
SKATETRICKS_UPLOAD_PRESIGN_DURATION=15m

# Optional override for the S3 bucket that receives raw uploaded skate videos
# Defaults to the CDN processed-media bucket if left unset
SKATETRICKS_TRANSCODING_INPUT_BUCKET=

# Optional override for the S3 bucket that stores transcoded MP4 outputs
# Defaults to the CDN processed-media bucket if left unset
SKATETRICKS_TRANSCODING_OUTPUT_BUCKET=

# MediaConvert execution role ARN created by the HomeWeb CDK stack
SKATETRICKS_MEDIACONVERT_ROLE_ARN=

# Optional CDN override for Skatetricks output playback URLs
SKATETRICKS_CDN_DOMAIN=https://cdn.thonbecker.com

# Optional max frames extracted from uploaded/imported MP4s for trick analysis
SKATETRICKS_ANALYSIS_MAX_FRAMES=24
SKATETRICKS_KNOWLEDGE_ENABLED=true
SKATETRICKS_KNOWLEDGE_CATALOG_RESOURCE=classpath:skatetricks/trick-catalog.yml
SKATETRICKS_VECTORSTORE_RECREATE=false

# =============================================================================
# Nextcloud CalDAV Integration
# =============================================================================
# Nextcloud username for calendar access
PERSONAL_NEXTCLOUD_USERNAME=

# Nextcloud app password (generate in Settings > Security > App passwords)
PERSONAL_NEXTCLOUD_APP_PASSWORD=

# =============================================================================
# Cloudflare Access booking administration
# =============================================================================
PERSONAL_CF_ACCESS_ISSUER=
PERSONAL_CF_ACCESS_AUDIENCE=
PERSONAL_CF_ACCESS_ADMIN_EMAIL=thon.becker@gmail.com

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
# Database Username
PERSONAL_DB_USERNAME=postgres

# Database Password
PERSONAL_DB_PASSWORD=

# =============================================================================
# Perenual Plant API
# =============================================================================
# API key for Perenual plant identification (https://perenual.com/docs/api)
PERSONAL_PERENUAL_API_KEY=
