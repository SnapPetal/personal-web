{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "thonbecker-family-quest",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Base config stays off workers.dev. deployment.jsonc attaches quest.thonbecker.biz
  // in the generated production Wrangler config.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public"
  },
  "ai": {
    "binding": "AI"
  },
  // No database_id or bucket_name: Wrangler provisions D1 and R2 on deploy.
  // Vectorize is intentionally absent. Wrangler does not provision indexes, and a missing
  // index would fail the shared Deploy workflow. Text search works until the binding is added.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thonbecker-family-quest",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NOTES"
    }
  ],
  "vars": {
    "AI_DAILY_CAP": "40",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_MODEL_FALLBACK": "@cf/meta/llama-3.1-8b-instruct-fast",
    "TTS_MODEL": "@cf/myshell-ai/melotts",
    "EMBED_MODEL": "@cf/baai/bge-small-en-v1.5"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
