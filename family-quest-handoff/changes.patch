+import { abilityModifier } from "./dice";
+import { clipText } from "./text";
+
+export type Ability = "strength" | "dexterity" | "constitution" | "intelligence" | "wisdom" | "charisma";
+
+export interface ClassDef {
+  id: string;
+  name: string;
+  blurb: string;
+  primary: Ability;
+  order: Ability[];
+  hp: number;
+  ac: number;
+  hitDie: number;
+  damage: string;
+  heal: string | null;
+  inventory: string;
+  portrait: string;
+}
+
+export interface DraftCharacter {
+  name: string;
+  classId: string;
+  className: string;
+  ancestry: string;
+  level: number;
+  hp: number;
+  maxHp: number;
+  ac: number;
+  strength: number;
+  dexterity: number;
+  constitution: number;
+  intelligence: number;
+  wisdom: number;
+  charisma: number;
+  inventory: string;
+  portrait: string;
+  hitDie: number;
+  damage: string;
+  heal: string | null;
+}
+
+export interface PartyResult {
+  ok: true;
+  party: DraftCharacter[];
+}
+
+export interface PartyError {
+  ok: false;
+  error: string;
+}
+
+export const ANCESTRIES = ["Human", "Elf", "Dwarf", "Halfling", "Gnome", "Dragonkin", "Catfolk", "Owlfolk"] as const;
+
+export const CLASSES: ClassDef[] = [
+  {
+    id: "knight",
+    name: "Brave Knight",
+    blurb: "A kind protector with a wooden shield and a practice sword.",
+    primary: "strength",
+    order: ["strength", "constitution", "wisdom", "charisma", "dexterity", "intelligence"],
+    hp: 12,
+    ac: 16,
+    hitDie: 10,
+    damage: "1d8",
+    heal: null,
+    inventory: "Practice sword, star shield, snack tin, bandage roll",
+    portrait: "stands tall in a bright cloak with a shield painted like a star",
+  },
+  {
+    id: "ranger",
+    name: "Forest Ranger",
+    blurb: "A careful explorer who talks to trails, birds, and weather.",
+    primary: "dexterity",
+    order: ["dexterity", "wisdom", "constitution", "strength", "intelligence", "charisma"],
+    hp: 10,
+    ac: 14,
+    hitDie: 8,
+    damage: "1d8",
+    heal: null,
+    inventory: "Short bow, leaf cloak, trail map, jar of honey",
