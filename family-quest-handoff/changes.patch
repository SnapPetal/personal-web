+  },
+  {
+    id: "healer",
+    name: "Kind Healer",
+    blurb: "A gentle mender whose magic looks like warm light.",
+    primary: "wisdom",
+    order: ["wisdom", "charisma", "constitution", "intelligence", "dexterity", "strength"],
