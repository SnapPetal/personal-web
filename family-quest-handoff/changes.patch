+    character.max_hp,
+    character.ac,
+  ) + ` STR ${character.strength} DEX ${character.dexterity} CON ${character.constitution} INT ${character.intelligence} WIS ${character.wisdom} CHA ${character.charisma}. Inventory: ${character.inventory}`;
