+function fighter(character: CharacterRecord): PartyFighter {
+  const heroClass = classById(character.class_id);
+  const primary = character[heroClass.primary];
+  return {
+    id: character.id,
+    name: character.name,
+    hp: character.hp,
+    maxHp: character.max_hp,
+    ac: character.ac,
+    dexterity: character.dexterity,
