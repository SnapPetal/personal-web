+  {
+    id: "wizard",
+    name: "Spark Wizard",
+    blurb: "A student of glittery, harmless magic and good questions.",
+    primary: "intelligence",
+    order: ["intelligence", "wisdom", "constitution", "charisma", "dexterity", "strength"],
