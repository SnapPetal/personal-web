+         UNION ALL
+         SELECT * FROM monsters WHERE cr_value <= ?1 AND source = 'srd'
+       ) AS picked
+       ORDER BY CASE source WHEN 'homebrew' THEN 0 ELSE 1 END, cr_value DESC, name
+       LIMIT 24`,
+    )
+    .bind(maxCr)
+    .all<MonsterRow>();
+  return (result.results ?? []).map(monsterFromRow);
