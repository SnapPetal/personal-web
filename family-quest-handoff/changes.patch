@@ -0,0 +1,59 @@
+import { describe, expect, it } from "vitest";
+import { MemoryUsageStore, capMessage, consumeCount, parseCap, tryConsumeAiCall, utcDay } from "../src/cost";
+
+describe("cost cap", () => {
+  it("allows a call under the cap and counts it", () => {
+    const result = consumeCount(0, 40, "2026-10-14", () => undefined);
+    expect(result).toMatchObject({ allowed: true, used: 1, remaining: 39, cap: 40 });
+  });
+
+  it("denies a call once the cap is reached and does not commit", () => {
+    let committed = false;
+    const result = consumeCount(40, 40, "2026-10-14", () => {
+      committed = true;
+    });
+    expect(result.allowed).toBe(false);
+    expect(result.remaining).toBe(0);
+    expect(committed).toBe(false);
+  });
+
+  it("treats a cap of zero as closed", () => {
+    expect(consumeCount(0, 0, "2026-10-14", () => undefined).allowed).toBe(false);
+  });
+
+  it("rejects invalid counts and caps", () => {
+    expect(() => consumeCount(-1, 10, "2026-10-14", () => undefined)).toThrow(/Usage/);
+    expect(() => consumeCount(0, -1, "2026-10-14", () => undefined)).toThrow(/Cap/);
+    expect(() => consumeCount(1.5, 10, "2026-10-14", () => undefined)).toThrow(/Usage/);
+  });
+
+  it("tracks each UTC day on its own", async () => {
+    const store = new MemoryUsageStore();
+    const first = await tryConsumeAiCall(store, 1, new Date("2026-10-14T23:30:00Z"));
+    const blocked = await tryConsumeAiCall(store, 1, new Date("2026-10-14T23:59:00Z"));
+    const nextDay = await tryConsumeAiCall(store, 1, new Date("2026-10-15T00:00:00Z"));
+    expect(utcDay(new Date("2026-10-14T23:30:00Z"))).toBe("2026-10-14");
+    expect(first.allowed).toBe(true);
+    expect(blocked.allowed).toBe(false);
+    expect(nextDay.allowed).toBe(true);
+    expect(nextDay.day).toBe("2026-10-15");
+    expect(store.counts.get("2026-10-14")).toBe(1);
+    expect(store.counts.get("2026-10-15")).toBe(1);
+  });
+
+  it("stops a memory store at the cap", async () => {
+    const store = new MemoryUsageStore();
+    const now = new Date("2026-10-14T12:00:00Z");
+    expect((await tryConsumeAiCall(store, 2, now)).allowed).toBe(true);
+    expect((await tryConsumeAiCall(store, 2, now)).remaining).toBe(0);
+    expect((await tryConsumeAiCall(store, 2, now)).allowed).toBe(false);
+  });
+
+  it("parses the configured cap and explains a full day", () => {
+    expect(parseCap(undefined)).toBe(40);
+    expect(parseCap("10")).toBe(10);
+    expect(() => parseCap("nope")).toThrow(/AI_DAILY_CAP/);
+    expect(capMessage(40)).toContain("40");
+    expect(capMessage(40)).toContain("Dice");
+  });
+});
diff --git a/packages/family-quest/test/dice.test.ts b/packages/family-quest/test/dice.test.ts
new file mode 100644
index 0000000..f246892
--- /dev/null
+++ b/packages/family-quest/test/dice.test.ts
@@ -0,0 +1,79 @@
+import { describe, expect, it } from "vitest";
+import {
+  abilityModifier,
+  critExpression,
+  describeRoll,
+  parseDice,
+  rollDice,
+  rollDie,
+  rollExpression,
+  scriptedSource,
+} from "../src/dice";
+
+describe("dice", () => {
+  it("maps uint32 values onto 1..sides", () => {
+    expect(rollDie(20, scriptedSource([0]))).toBe(1);
+    expect(rollDie(20, scriptedSource([19]))).toBe(20);
+    expect(rollDie(6, scriptedSource([5]))).toBe(6);
+  });
+
+  it("rejects biased values and draws again", () => {
+    const limit = Math.floor(0x1_0000_0000 / 20) * 20;
+    expect(rollDie(20, scriptedSource([limit, 4]))).toBe(5);
+  });
+
+  it("rolls advantage and disadvantage on a d20", () => {
+    const advantage = rollDice({ count: 1, sides: 20, modifier: 2, mode: "advantage" }, scriptedSource([19, 3]));
+    expect(advantage.kept).toEqual([20]);
+    expect(advantage.dropped).toEqual([4]);
+    expect(advantage.total).toBe(22);
+    expect(advantage.critical).toBe(true);
+
+    const disadvantage = rollDice(
+      { count: 1, sides: 20, modifier: 0, mode: "disadvantage" },
+      scriptedSource([19, 3]),
+    );
+    expect(disadvantage.kept).toEqual([4]);
+    expect(disadvantage.dropped).toEqual([20]);
+    expect(disadvantage.fumble).toBe(false);
+    expect(disadvantage.total).toBe(4);
+  });
+
+  it("drops nothing when both advantage dice match", () => {
+    const roll = rollExpression("1d20+3", scriptedSource([7, 7]), "advantage");
+    expect(roll.kept).toEqual([8]);
+    expect(roll.dropped).toEqual([]);
+    expect(roll.total).toBe(11);
+    expect(describeRoll(roll)).toContain("Total 11");
+  });
+
+  it("refuses advantage on anything except a single d20", () => {
+    expect(() => rollDice({ count: 2, sides: 6, modifier: 0, mode: "advantage" }, scriptedSource([1, 1]))).toThrow(
+      /single d20/,
+    );
+  });
+
+  it("parses notation and doubles dice on a crit without doubling the modifier", () => {
+    expect(parseDice("d8")).toEqual({ count: 1, sides: 8, modifier: 0 });
+    expect(parseDice("2d6+1")).toEqual({ count: 2, sides: 6, modifier: 1 });
+    expect(parseDice("1d20-1")).toEqual({ count: 1, sides: 20, modifier: -1 });
+    expect(critExpression("1d8+2")).toBe("2d8+2");
+    expect(() => parseDice("3d7+1")).toThrow(/d4/);
+  });
+
+  it("flags a natural 1 and a natural 20", () => {
+    const fumble = rollExpression("1d20+5", scriptedSource([0]));
+    const crit = rollExpression("1d20", scriptedSource([19]));
+    expect(fumble.fumble).toBe(true);
+    expect(fumble.total).toBe(6);
+    expect(crit.critical).toBe(true);
+    expect(crit.natural).toBe(20);
+  });
+
+  it("computes ability modifiers", () => {
+    expect(abilityModifier(10)).toBe(0);
+    expect(abilityModifier(8)).toBe(-1);
+    expect(abilityModifier(15)).toBe(2);
+    expect(() => abilityModifier(10.5)).toThrow(/whole number/);
+  });
+});
diff --git a/packages/family-quest/test/dm.test.ts b/packages/family-quest/test/dm.test.ts
