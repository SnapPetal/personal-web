+    hp: 9,
+    ac: 13,
+    hitDie: 8,
+    damage: "1d6",
+    heal: null,
+    inventory: "Soft boots, loop of string, pocket mirror, cinnamon stick",
+    portrait: "moves quietly in soft boots with a pocket mirror on a cord",
